<ApLocationMixed>:
    text: "Server:"
    size_hint_x: None
    canvas:
        Color:
            rgb: 0,0,0
        Rectangle:
            pos: self.x - app.loc_border-self.width/2, self.y - app.loc_border-self.height/2
            size: self.width + (app.loc_border * 2), self.height + (app.loc_border * 2)
        Color:
            rgb: self.color
        Rectangle:
            pos: self.x-self.width/2, self.y-self.height/2
            size: self.size

<ApLocationSplit>:
    text: "Server:"
    size_hint_x: None
    color_2: (1, 0, 0)
    color_4: (1, 1, 0)
    color_1: (0, 1, 0)
    color_3: (0, 0, 1)
    canvas:
        Color:
            rgb: 0,0,0
        Rectangle:
            pos: self.x - app.loc_border-self.width/2, self.y - app.loc_border-self.height/2
            size: self.width + (app.loc_border * 2), self.height + (app.loc_border * 2)
        Color:
            rgb: self.color_1
        Triangle:
            points: self.x, self.y, self.x - (self.width / 2), self.y + (self.height /2), self.x + (self.width / 2), self.y + (self.height /2)
        Color:
            rgb: self.color_3
        Triangle:
            points: self.x, self.y, self.x + (self.width / 2), self.y - (self.height /2), self.x + (self.width / 2), self.y + (self.height /2)
        Color:
            rgb: self.color_2
        Triangle:
            points: self.x, self.y, self.x - (self.width / 2), self.y - (self.height /2), self.x + (self.width / 2), self.y - (self.height /2)
        Color:
            rgb: self.color_4
        Triangle:
            points: self.x, self.y, self.x - (self.width / 2), self.y - (self.height /2), self.x - (self.width / 2), self.y + (self.height /2)

<MappingTracker>:
    BoxLayout:
        orientation: "vertical"
        BoxLayout:
            orientation: "horizontal"
            pos_hint: {'center_x': 0.5}
            size_hint: None, None
            size: self.minimum_size
            spacing: dp(10)
            BoxLayout:
                id: mapping_tab_selectors
                orientation: "horizontal"
                size_hint: None, None
                size: self.minimum_size
                spacing: dp(10)
        ZoomableMapHost:
            id: map_host
            size_hint: 1, 1
            MapScatter:
                id: map_scatter
                do_rotation: False
                do_scale: False
                do_translation: False
                auto_bring_to_front: False
                FloatLayout:
                    id: map_layer
                    size_hint: None, None
                    ApAsyncImage:
                        id: tracker_map
                        size_hint: 1, 1
                        pos: 0, 0
                        source: app.mapping_source
                        fit_mode: "contain"
                    Widget:
                        id: location_canvas
                        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                        size_hint: None, None
                        size: dp(1), dp(1)
                        canvas.before:
                            PushMatrix:
                            Rotate:
                                origin: tracker_map.center
                                angle: 180
                                axis: 1, 0, 0
                            Translate:
                                xy: (tracker_map.x + (tracker_map.width - tracker_map.norm_image_size[0])/2, tracker_map.y + (tracker_map.height - tracker_map.norm_image_size[1])/2)
                            Scale:
                                origin: 0,0
                                x: tracker_map.norm_image_size[0] / tracker_map.texture_size[0] if tracker_map.texture_size[0] > 0 else 1
                                y: tracker_map.norm_image_size[1] / tracker_map.texture_size[1] if tracker_map.texture_size[1] > 0 else 1
                        canvas.after:
                            PopMatrix:

<ItemQualityFilter>:
    orientation: "horizontal"
    spacing: dp(4)
    size_hint_y: None
    height: dp(32)
    text: ""
    filter_key: ""
    active: True
    MDCheckbox:
        id: quality_checkbox
        active: root.active
        on_active: root.active = self.active
    MDLabel:
        adaptive_size: True
        text: root.text
        valign: "center"

<ItemsView>:
    viewclass: 'SelectableLabel'
    scroll_y: 1
    scroll_type: ["content", "bars"]
    bar_width: dp(12)
    effect_cls: "ScrollEffect"
    SelectableRecycleBoxLayout:
        default_size: None, dp(24)
        default_size_hint: 1, None
        size_hint_y: None
        height: self.minimum_height
        orientation: 'vertical'
        spacing: dp(3)
